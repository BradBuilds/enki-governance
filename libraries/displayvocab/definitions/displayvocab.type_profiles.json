{
  "id": "display.profile.type_profiles",
  "type": "custom",
  "version": "0.1.0",
  "description": "Per-canonical-type list of structured-profile field keys to display in the entity dossier card. Field keys are matched against the keys present in a Wikidata structured_profile finding's data jsonb (and as a fallback, against the keys in a Wikipedia summary finding). The card renders the first N fields from this list that have non-empty values for the entity. Order = priority = display order.",

  "_routing_principles": [
    "Only show fields that mean something for this type. A 'capital' field on a person is noise; an 'occupation' field on a country is noise. The point of this pack is to keep that noise off the card.",
    "Order the list by what a human glances at first. For a country: capital + population + currency before iso_3166. For a person: born/died + occupation + nationality before religion/awards. For an organization: founded + HQ + industry before stock_exchange.",
    "Fields that DON'T appear in this list are still in the underlying data — the operator can drill into the raw research findings to see them. The card just doesn't surface them by default.",
    "Subtypes (city vs country, vehicle vs aircraft) are handled via the most-specific match: lookup tries (canonical_type + subtype) first, falls back to canonical_type. Subtypes use dot notation: 'place.city', 'asset.aircraft'."
  ],

  "content": {
    "type_profiles": {
      "country": [
        "capital",
        "population",
        "area_km2",
        "currency",
        "official_languages",
        "continent",
        "located_in",
