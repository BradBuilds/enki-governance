{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://enki.system/schemas/registry_pack.schema.json",
  "title": "ENKI Registry Pack",
  "description": "Schema for ENKI definition pack metadata",
  "type": "object",
  "required": ["pack_id", "version", "name", "definitions"],
  "properties": {
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9._-]*[a-z0-9])?$",
      "description": "Unique identifier for this pack"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the pack"
    },
    "name": {
      "type": "string",
      "description": "Human-readable pack name"
    },
    "description": {
      "type": "string",
      "description": "Pack description"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Definition identifier"
          },
          "path": {
            "type": "string",
            "description": "Relative path to definition file"
          },
          "type": {
            "type": "string",
            "description": "Definition type"
          }
        }
      },
      "minItems": 1,
      "description": "List of definitions in this pack"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pack_id", "version"],
        "properties": {
          "pack_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "description": "Other packs this depends on"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "modified": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "namespaces_owned": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$",
        "description": "Lowercase dot-path namespace prefix"
      },
      "description": "Namespace prefixes owned by this pack (S1.2)"
    },
    "capabilities_provided": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "version"],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$",
            "description": "Lowercase dot-path capability name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version (exact match required)"
          }
        }
      },
      "description": "Capabilities this pack provides (S1.1)"
    },
    "capabilities_required": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "version"],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$",
            "description": "Lowercase dot-path capability name"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "Semantic version (exact match required)"
          }
        }
      },
      "description": "Capabilities this pack requires (S1.1)"
    }
  }
}
