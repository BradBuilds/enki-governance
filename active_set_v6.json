  "metadata": {
    "name": "Active Set v6.0.0 - Entity Resolution Governance",
    "description": "Adds entityvocab pack: canonical entity resolution rules, per-type identifier schemas, normalization rules, merge/split policy, LLM arbitration prompt template, and enrichment task definitions. Together with nodevocab (entity subtypes) and completenessvocab (dossier scoring), this enables the unified entity resolution pipeline where all entity creation \u2014 from signals, enrichment, and watch topics \u2014 passes through a single GDU-governed resolver.",
    "created": "2026-04-11T00:00:00Z",
    "author": "ENKI System",
    "purpose": "Enable GDU-governed entity resolution: canonical dedup, merge/split with redirects, enrichment queue, and audit trail",
    "design_basis": "Built against the three-layer entity problem: signal-ingest entities (entity_resolver.py), knowledge_nodes entities (knowledge/resolver.py), and watch_topic_entities (processor.py) were disconnected. entityvocab unifies them under one governed resolution path.",
    "_activation_status": "DRAFT \u2014 content_hashes computed; HWKEY signing pending",
    "_supersedes": "active_set_v6.1.0",
    "_changelog": [
      "5.0.0 (2026-04-10): initial v5 activation with knowledge graph rebuild vocabulary",
      "5.0.1 (2026-04-11): signalvocab 0.1.0 \u2192 0.1.1 \u2014 adds signal.environmental.weather_alert",
      "6.0.0 (2026-04-11): adds entityvocab 0.1.0 \u2014 entity resolution rules, enrichment types, governed arbitration prompt",
      "6.2.0 (2026-05-05): collapse rebuild \u2014 nodevocab 0.2.0\u21920.3.0 (per-subtype collapse_key_rules), entityvocab 0.1.0\u21920.2.0 (top-level normalize_rules), adds canonicalpack 1.0.0 + gazetteerpack 1.0.0"
    ]
  }
