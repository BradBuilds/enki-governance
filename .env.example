# Enki Governance — Environment Configuration
# Copy to .env and fill in values:  cp .env.example .env
# NEVER commit .env to version control
#
# ONBOARDING SEQUENCE:
#   1. Copy this file: cp .env.example .env
#   2. Generate secrets: openssl rand -base64 48 (for passwords below)
#   3. Start services: docker compose up -d
#   4. Run bootstrap: docker compose exec api python scripts/enki-bootstrap.py
#   5. Open UI and complete setup wizard
#   6. Check onboarding: GET /onboarding/status

# ── Docker Compose (used by compose.yaml) ──────────────────────────────────
POSTGRES_USER=enki_db
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_48
ENKI_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_48

# ── Enki Core (REQUIRED) ───────────────────────────────────────────────────
ENKI_ROOT_PASSWORD=your-secure-password-here
ENKI_HARDWARE_PROFILE=EMULATED
ENKI_DB_DSN=postgresql://enki_db:enki_pass@localhost:5432/enki
ENKI_NODE_ID=dev-node-01
ENKI_AUTH_MODE=dev

# ── Ollama (local LLM — Gemma 4 recommended) ──────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b

# ── Logto (OIDC auth server) ──────────────────────────────────────────────
LOGTO_ENDPOINT=http://logto:3001
# LOGTO_APP_ID=your-app-id                   # Set after Logto first-run
# LOGTO_APP_SECRET=your-app-secret           # Set after Logto first-run

# ── Network & Offline Mode ─────────────────────────────────────────────────
# ENKI_NETWORK_MODE=connected          # connected | offline | intermittent
# ENKI_AI_MODE=local                   # local | cloud | hybrid
# ENKI_TILE_SOURCE=remote              # remote | local | cache
# ENKI_GEOCODE_MODE=remote             # remote | local | cache

# ── Optional: Paths (defaults shown) ──
# ENKI_ROOT_KEY_PATH=storage/keys/root_key.enc
# ENKI_GRANTS_DIR=storage/grants

# ── Optional: Auth settings ──
# ENKI_CHALLENGE_TTL_SECONDS=300

# ── Optional: API Server ──
# ENKI_API_HOST=127.0.0.1
# ENKI_API_PORT=8000
# ENKI_ORIGIN=*

# ── Optional: OSRM (route matching) ──
# OSRM_URL=http://localhost:5001

# ── Optional: Cloud AI (configure via setup wizard or /onboarding/register-api) ──
# These are stored encrypted in the database, not in env.
# Register at:
#   Groq (free tier):     https://console.groq.com/keys
#   Google Gemini (free):  https://aistudio.google.com/apikey
#   Anthropic:            https://console.anthropic.com/
#   OpenAI:               https://platform.openai.com/api-keys

# ── SvelteKit (adapter-node behind reverse proxy) ─────────────────────────
# Tell SvelteKit to trust Caddy's forwarded headers so url.origin is correct
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host
# Or set ORIGIN directly:  ORIGIN=https://example.com
